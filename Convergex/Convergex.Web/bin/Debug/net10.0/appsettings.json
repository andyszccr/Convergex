{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=convergex.db"
  },
  "ExchangeRateApi": {
    "BaseUrl": "https://open.er-api.com/v6/latest/",
    "TimeoutSeconds": 10,
    "BaseCurrencyCode": "USD",
    "DefaultSpreadPercent": 2.0
  },
  "ExchangeRateSync": {
    "Enabled": true,
    "IntervalMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
