@model IReadOnlyList<Convergex.Application.DTOs.ExchangeRates.ExchangeRateDto>
@{
    ViewData["Title"] = "Tasas de cambio";
    var isAdmin = User.IsInRole("Administrador");
}

<section class="module-page">
    <div class="module-header">
        <div>
            <h1>Tasas de cambio</h1>
            <p>Consulta y administra las paridades disponibles.</p>
        </div>
        @if (isAdmin)
        {
            <a asp-action="Create" class="btn btn-primary-cx">Nueva tasa</a>
        }
    </div>

    @if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

    <article class="panel">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Par</th>
                        <th>Origen</th>
                        <th>Destino</th>
                        <th>Tasa</th>
                        <th>Actualizada</th>
                        @if (isAdmin) { <th></th> }
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Pair</td>
                        <td>@item.BaseCode</td>
                        <td>@item.TargetCode</td>
                        <td>@item.Rate.ToString("N6")</td>
                        <td>@item.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        @if (isAdmin)
                        {
                            <td class="table-actions">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('¿Eliminar esta tasa?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                </form>
                            </td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </article>
</section>
