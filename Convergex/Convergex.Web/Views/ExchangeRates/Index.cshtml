@model IReadOnlyList<Convergex.Application.DTOs.ExchangeRates.ExchangeRateDto>
@{
    ViewData["Title"] = "Tasas de cambio";
    var isAdmin = User.IsInRole("Administrador");
}

<section class="module-page">
    <div class="module-header">
        <div>
            <h1>Tasas de cambio</h1>
            <p>Paridades vigentes de la casa de cambio (compra / venta).</p>
        </div>
        <div class="module-actions">
            <a asp-action="History" class="btn btn-outline-secondary"><i class="bi bi-clock-history"></i> Ver historial</a>
            @if (isAdmin)
            {
                <form asp-action="SyncNow" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-primary"><i class="bi bi-arrow-repeat"></i> Sincronizar ahora</button>
                </form>
                <a asp-action="Create" class="btn btn-primary-cx"><i class="bi bi-plus-lg"></i> Nueva tasa</a>
            }
        </div>
    </div>

    @if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

    <article class="panel">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Par</th>
                        <th>Compra</th>
                        <th>Venta</th>
                        <th>Vigente desde</th>
                        <th>Fuente</th>
                        <th>Publicada por</th>
                        @if (isAdmin) { <th></th> }
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="empty-cell">No hay tasas activas registradas.</td></tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Pair</td>
                            <td>@item.BuyRate.ToString("N6")</td>
                            <td>@item.SellRate.ToString("N6")</td>
                            <td>@item.EffectiveAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="pill @(item.Source == Convergex.Domain.Enums.ExchangeRateSource.Api ? "pill-teal" : "pill-blue")">@item.SourceName</span></td>
                            <td>@(item.CreatedByName ?? "—")</td>
                            @if (isAdmin)
                            {
                                <td class="table-actions">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                    <form asp-action="Deactivate" asp-route-id="@item.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Desactivar esta tasa? Ya no se usará para conversiones.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Desactivar</button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </article>
</section>
