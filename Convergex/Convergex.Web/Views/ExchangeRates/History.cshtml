@model Convergex.Web.ViewModels.ExchangeRates.ExchangeRateHistoryFilterViewModel
@using Convergex.Domain.Enums
@{
    ViewData["Title"] = "Historial de tasas de cambio";

    string StatusPill(ExchangeRateStatus status) => status switch
    {
        ExchangeRateStatus.Active => "pill-green",
        ExchangeRateStatus.Inactive => "pill-muted",
        _ => "pill-orange"
    };
}

<section class="module-page">
    <div class="module-header">
        <div>
            <h1>Historial de tasas de cambio</h1>
            <p>Auditoría completa de publicaciones: manuales y por sincronización automática.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Volver a tasas vigentes</a>
    </div>

    <article class="panel form-panel">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Moneda origen</label>
                <select name="baseCurrencyId" class="form-select" asp-for="BaseCurrencyId" asp-items="Model.Currencies">
                    <option value="">Todas</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Moneda destino</label>
                <select name="targetCurrencyId" class="form-select" asp-for="TargetCurrencyId" asp-items="Model.Currencies">
                    <option value="">Todas</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Fuente</label>
                <select name="source" class="form-select" asp-for="Source">
                    <option value="">Todas</option>
                    <option value="Manual">Manual</option>
                    <option value="Api">API</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Desde</label>
                <input type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Hasta</label>
                <input type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary-cx">Filtrar</button>
                <a asp-action="History" class="btn btn-outline-secondary">Limpiar</a>
            </div>
        </form>
    </article>

    <article class="panel">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Vigente desde</th>
                        <th>Par</th>
                        <th>Compra</th>
                        <th>Venta</th>
                        <th>Variación</th>
                        <th>Fuente</th>
                        <th>Estado</th>
                        <th>Publicada por</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Result.Items.Any())
                {
                    <tr><td colspan="8" class="empty-cell">No hay registros para los filtros seleccionados.</td></tr>
                }
                else
                {
                    foreach (var item in Model.Result.Items)
                    {
                        <tr>
                            <td>@item.EffectiveAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@item.Pair</td>
                            <td>@item.BuyRate.ToString("N6")</td>
                            <td>@item.SellRate.ToString("N6")</td>
                            <td>
                                @if (item.VariationPercent.HasValue)
                                {
                                    <span class="variation @(item.VariationPercent.Value >= 0 ? "up" : "down")">
                                        @(item.VariationPercent.Value >= 0 ? "↑" : "↓")
                                        @Math.Abs(item.VariationPercent.Value).ToString("0.##")%
                                    </span>
                                }
                                else
                                {
                                    <span class="text-secondary">—</span>
                                }
                            </td>
                            <td><span class="pill @(item.Source == ExchangeRateSource.Api ? "pill-teal" : "pill-blue")">@item.SourceName</span></td>
                            <td><span class="pill @StatusPill(item.Status)">@item.StatusName</span></td>
                            <td>@(item.CreatedByName ?? "—")</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>

        @if (Model.Result.TotalPages > 1)
        {
            <nav aria-label="Paginación de historial" class="mt-3">
                <ul class="pagination justify-content-center mb-0">
                    @for (var p = 1; p <= Model.Result.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Result.Page ? "active" : "")">
                            <a class="page-link" asp-action="History"
                               asp-route-baseCurrencyId="@Model.BaseCurrencyId"
                               asp-route-targetCurrencyId="@Model.TargetCurrencyId"
                               asp-route-source="@Model.Source"
                               asp-route-fromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                               asp-route-toDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                               asp-route-page="@p">@p</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </article>
</section>
