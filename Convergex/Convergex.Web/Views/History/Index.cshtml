@model Convergex.Web.ViewModels.Conversions.ConversionHistoryFilterViewModel
@{
    ViewData["Title"] = "Historial de conversiones";
    var filters = new Dictionary<string, string?>
    {
        ["type"] = Model.Type?.ToString() ?? string.Empty,
        ["userName"] = Model.UserName,
        ["fromDate"] = Model.FromDate?.ToString("yyyy-MM-dd"),
        ["toDate"] = Model.ToDate?.ToString("yyyy-MM-dd")
    };
    var totalPages = Model.TotalPages;
}

<section class="module-page">
    <div class="module-header">
        <div>
            <h1>Historial</h1>
            <p>Conversiones registradas en el sistema.</p>
        </div>
        <a asp-controller="CurrencyConversion" asp-action="Index" class="btn btn-primary-cx">Nueva conversión</a>
    </div>

    <article class="panel form-panel">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Tipo</label>
                <select name="type" class="form-select" asp-for="Type">
                    <option value="">Todos</option>
                    <option value="Currency">Moneda</option>
                    <option value="Unit">Unidad</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Usuario</label>
                <input name="userName" value="@Model.UserName" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Desde</label>
                <input type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Hasta</label>
                <input type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary-cx">Filtrar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
            </div>
        </form>
    </article>

    <article class="panel">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th>De</th>
                        <th>A</th>
                        <th>Monto</th>
                        <th>Resultado</th>
                        <th>Tasa</th>
                        <th>Usuario</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="8" class="empty-cell">No hay conversiones para los filtros seleccionados.</td></tr>
                }
                else
                {
                    foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <span class="pill @(item.Type == "Currency" ? "pill-blue" : "pill-green")">
                                    @(item.Type == "Currency" ? "Moneda" : "Unidad")
                                </span>
                            </td>
                            <td>@item.FromCode</td>
                            <td>@item.ToCode</td>
                            <td>@item.Amount.ToString("N2")</td>
                            <td>@item.Result.ToString("N4")</td>
                            <td>@item.RateApplied.ToString("N6")</td>
                            <td>@(item.UserName ?? "—")</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </article>

    @if (totalPages > 0)
    {
        <nav aria-label="Paginación del historial" class="d-flex flex-column align-items-center gap-2">
            <ul class="pagination mb-0">
                @if (Model.Page > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-all-route-data="filters" asp-route-page="@(Model.Page - 1)">Anterior</a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled"><span class="page-link">Anterior</span></li>
                }
                @for (var i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-all-route-data="filters" asp-route-page="@i">@i</a>
                    </li>
                }
                @if (Model.Page < totalPages)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-all-route-data="filters" asp-route-page="@(Model.Page + 1)">Siguiente</a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled"><span class="page-link">Siguiente</span></li>
                }
            </ul>
            <p class="mb-0 text-secondary small">
                Página @Model.Page de @totalPages · @Model.TotalItems conversiones
            </p>
        </nav>
    }
</section>
