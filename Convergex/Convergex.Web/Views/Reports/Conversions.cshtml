@model Convergex.Web.ViewModels.Reports.ConversionsReportViewModel
@using Convergex.Domain.Enums
@{
    ViewData["Title"] = "Reportes - Conversiones";
    ViewData["ActiveTab"] = "conversions";
    var f = Model.Filter;
}

<section class="module-page">
    <div class="module-header">
        <div>
            <h1>Centro de Reportes</h1>
            <p>Consulta, previsualiza y exporta la información operativa y estratégica de Convergex.</p>
        </div>
        <div class="module-actions">
            <a asp-action="Export" asp-route-report="conversions" asp-route-format="pdf"
               asp-route-fromDate="@(f.FromDate?.ToString("yyyy-MM-dd"))" asp-route-toDate="@(f.ToDate?.ToString("yyyy-MM-dd"))"
               asp-route-type="@f.Type" asp-route-currencyCode="@f.CurrencyCode" asp-route-userName="@f.UserName"
               class="btn btn-outline-danger"><i class="bi bi-file-earmark-pdf"></i> Exportar PDF</a>
            <a asp-action="Export" asp-route-report="conversions" asp-route-format="excel"
               asp-route-fromDate="@(f.FromDate?.ToString("yyyy-MM-dd"))" asp-route-toDate="@(f.ToDate?.ToString("yyyy-MM-dd"))"
               asp-route-type="@f.Type" asp-route-currencyCode="@f.CurrencyCode" asp-route-userName="@f.UserName"
               class="btn btn-outline-success"><i class="bi bi-file-earmark-excel"></i> Exportar Excel</a>
        </div>
    </div>

    <partial name="_ReportTabs" />

    <div class="kpi-grid">
        <article class="stat-card">
            <div class="stat-icon bg-blue"><i class="bi bi-arrow-left-right"></i></div>
            <div class="stat-body">
                <span class="stat-label">Operaciones</span>
                <strong class="stat-value">@Model.Report.TotalOperations.ToString("N0")</strong>
            </div>
        </article>
        <article class="stat-card">
            <div class="stat-icon bg-green"><i class="bi bi-cash-stack"></i></div>
            <div class="stat-body">
                <span class="stat-label">Monto total operado</span>
                <strong class="stat-value">@Model.Report.TotalAmount.ToString("N2")</strong>
            </div>
        </article>
        <article class="stat-card">
            <div class="stat-icon bg-violet"><i class="bi bi-graph-up-arrow"></i></div>
            <div class="stat-body">
                <span class="stat-label">Resultado total</span>
                <strong class="stat-value">@Model.Report.TotalResult.ToString("N2")</strong>
            </div>
        </article>
        <article class="stat-card">
            <div class="stat-icon bg-orange"><i class="bi bi-percent"></i></div>
            <div class="stat-body">
                <span class="stat-label">Tasa promedio</span>
                <strong class="stat-value">@Model.Report.AverageRate.ToString("N4")</strong>
            </div>
        </article>
    </div>

    <article class="panel form-panel">
        <form method="get" class="row g-3">
            <div class="col-md-2">
                <label class="form-label">Desde</label>
                <input type="date" name="fromDate" value="@(f.FromDate?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Hasta</label>
                <input type="date" name="toDate" value="@(f.ToDate?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Tipo</label>
                <select name="type" class="form-select">
                    <option value="" selected="@(f.Type is null)">Todos</option>
                    <option value="Currency" selected="@(f.Type == ConversionType.Currency)">Moneda</option>
                    <option value="Unit" selected="@(f.Type == ConversionType.Unit)">Unidad</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Moneda</label>
                <select name="currencyCode" class="form-select">
                    <option value="">Todas</option>
                    @foreach (var item in f.CurrencyCodes)
                    {
                        <option value="@item.Value" selected="@(f.CurrencyCode == item.Value)">@item.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Usuario</label>
                <input name="userName" value="@f.UserName" class="form-control" placeholder="Nombre del usuario..." />
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <button type="submit" class="btn btn-primary-cx w-100">Filtrar</button>
            </div>
        </form>
    </article>

    <article class="panel">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th>De</th>
                        <th>A</th>
                        <th>Monto</th>
                        <th>Tasa aplicada</th>
                        <th>Resultado</th>
                        <th>Usuario</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Report.Items.Any())
                {
                    <tr><td colspan="8" class="empty-cell">No hay operaciones para los filtros seleccionados.</td></tr>
                }
                else
                {
                    foreach (var item in Model.Report.Items)
                    {
                        <tr>
                            <td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="pill @(item.TypeName == "Moneda" ? "pill-blue" : "pill-green")">@item.TypeName</span></td>
                            <td>@item.FromCode</td>
                            <td>@item.ToCode</td>
                            <td>@item.Amount.ToString("N2")</td>
                            <td>@item.RateApplied.ToString("N6")</td>
                            <td>@item.Result.ToString("N4")</td>
                            <td>@(item.UserName ?? "—")</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Paginación de reporte" class="mt-3">
                <ul class="pagination justify-content-center mb-0">
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == f.Page ? "active" : "")">
                            <a class="page-link" asp-action="Conversions"
                               asp-route-fromDate="@(f.FromDate?.ToString("yyyy-MM-dd"))" asp-route-toDate="@(f.ToDate?.ToString("yyyy-MM-dd"))"
                               asp-route-type="@f.Type" asp-route-currencyCode="@f.CurrencyCode" asp-route-userName="@f.UserName"
                               asp-route-page="@p">@p</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </article>
</section>
