@model IReadOnlyList<Convergex.Application.DTOs.Currencies.CurrencyDto>
@using Convergex.Application.DTOs.Currencies
@{
    ViewData["Title"] = "Monedas";
    var isAdmin = User.IsInRole("Administrador");
    var canManage = ViewBag.CanManage as bool? ?? isAdmin;
    var suggestions = ViewBag.Suggestions as IReadOnlyList<CurrencySuggestionDto> ?? [];
}

<section class="module-page">
    <div class="module-header">
        <div>
            <h1>Monedas</h1>
            <p>Catálogo de monedas del sistema. Agrega las que necesites para convertir.</p>
        </div>
        @if (canManage)
        {
            <a asp-action="Create" class="btn btn-primary-cx">
                <i class="bi bi-plus-lg"></i> Nueva moneda
            </a>
        }
    </div>

    @if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

    @if (canManage && suggestions.Count > 0)
    {
        <article class="panel mb-3">
            <div class="module-header" style="margin-bottom: 0.75rem;">
                <div>
                    <h2 style="font-size: 1.05rem; margin: 0;">Agregar monedas comunes</h2>
                    <p style="margin: 0.25rem 0 0;">Un clic para incorporarlas al catálogo.</p>
                </div>
            </div>
            <div class="currency-chip-row">
                @foreach (var item in suggestions)
                {
                    <form asp-action="QuickAdd" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="code" value="@item.Code" />
                        <button type="submit" class="currency-chip" title="@item.Name">
                            <strong>@item.Code</strong>
                            <span>@item.Symbol</span>
                            <small>@item.Name</small>
                        </button>
                    </form>
                }
            </div>
        </article>
    }

    <article class="panel">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Símbolo</th>
                        <th>Estado</th>
                        @if (isAdmin) { <th></th> }
                    </tr>
                </thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="@(isAdmin ? 5 : 4)" class="text-muted">
                            Aún no hay monedas. @(canManage ? "Usa el botón Nueva moneda o las sugerencias de arriba." : "Solicita a un administrador que las agregue.")
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Code</td>
                        <td>@item.Name</td>
                        <td>@item.Symbol</td>
                        <td>
                            <span class="pill @(item.IsActive ? "pill-green" : "pill-muted")">
                                @(item.IsActive ? "Activa" : "Inactiva")
                            </span>
                        </td>
                        @if (isAdmin)
                        {
                            <td class="table-actions">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('¿Eliminar esta moneda?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                </form>
                            </td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </article>
</section>
