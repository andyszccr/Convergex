@model Convergex.Web.ViewModels.Account.ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Restablecer contraseña";
}

<div class="auth-shell auth-shell-simple">
    <section class="auth-panel auth-panel-full">
        <div class="auth-card">
            <a asp-action="Login" class="back-link"><i class="bi bi-arrow-left"></i> Volver al login</a>
            <h2>Restablecer contraseña</h2>
            <p class="auth-subtitle">Usa el token recibido para definir una nueva contraseña.</p>

            @if (TempData["Info"] is string info)
            {
                <div class="alert alert-info">@info</div>
            }

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <form asp-action="ResetPassword" method="post" class="auth-form">
                <div class="form-group">
                    <label asp-for="Email"></label>
                    <div class="input-wrap">
                        <i class="bi bi-envelope"></i>
                        <input asp-for="Email" class="form-control" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Token"></label>
                    <div class="input-wrap">
                        <i class="bi bi-key"></i>
                        <input asp-for="Token" class="form-control" placeholder="Token" />
                    </div>
                    <span asp-validation-for="Token" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="NewPassword"></label>
                    <div class="input-wrap">
                        <i class="bi bi-lock"></i>
                        <input asp-for="NewPassword" class="form-control" />
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ConfirmPassword"></label>
                    <div class="input-wrap">
                        <i class="bi bi-lock-fill"></i>
                        <input asp-for="ConfirmPassword" class="form-control" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <button type="submit" class="btn-login">Guardar contraseña</button>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
