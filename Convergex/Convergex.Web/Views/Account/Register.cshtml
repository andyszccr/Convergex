@model Convergex.Web.ViewModels.Account.RegisterViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Crear cuenta";
}

<div class="auth-shell auth-shell-simple">
    <section class="auth-panel auth-panel-full">
        <div class="auth-card">
            <a asp-action="Login" class="back-link"><i class="bi bi-arrow-left"></i> Volver al login</a>
            <h2>Crear cuenta</h2>
            <p class="auth-subtitle">Regístrate para empezar a convertir monedas y unidades.</p>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <form asp-action="Register" method="post" class="auth-form" novalidate>
                <div class="form-group">
                    <label asp-for="FullName"></label>
                    <div class="input-wrap">
                        <i class="bi bi-person"></i>
                        <input asp-for="FullName" class="form-control" placeholder="Tu nombre completo" autocomplete="name" />
                    </div>
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email"></label>
                    <div class="input-wrap">
                        <i class="bi bi-envelope"></i>
                        <input asp-for="Email" class="form-control" placeholder="usuario@correo.com" autocomplete="username" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password"></label>
                    <div class="input-wrap">
                        <i class="bi bi-lock"></i>
                        <input asp-for="Password" class="form-control" placeholder="Mínimo 6 caracteres" autocomplete="new-password" id="registerPassword" />
                        <button type="button" class="toggle-password" data-target="registerPassword" aria-label="Mostrar contraseña">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword"></label>
                    <div class="input-wrap">
                        <i class="bi bi-lock-fill"></i>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Repite la contraseña" autocomplete="new-password" id="confirmPassword" />
                        <button type="button" class="toggle-password" data-target="confirmPassword" aria-label="Mostrar contraseña">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-login">
                    <i class="bi bi-person-plus"></i>
                    Crear cuenta
                </button>
            </form>

            <p class="auth-register">
                ¿Ya tienes una cuenta?
                <a asp-action="Login" class="link">Inicia sesión</a>
            </p>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
