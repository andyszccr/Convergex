@model Convergex.Web.ViewModels.Account.ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Recuperar contraseña";
}

<div class="auth-shell auth-shell-simple">
    <section class="auth-panel auth-panel-full">
        <div class="auth-card">
            <a asp-action="Login" class="back-link"><i class="bi bi-arrow-left"></i> Volver al login</a>
            <h2>Recuperar contraseña</h2>
            <p class="auth-subtitle">Ingresa tu correo y generaremos un token de recuperación.</p>

            <form asp-action="ForgotPassword" method="post" class="auth-form">
                <div class="form-group">
                    <label asp-for="Email"></label>
                    <div class="input-wrap">
                        <i class="bi bi-envelope"></i>
                        <input asp-for="Email" class="form-control" placeholder="usuario@convergex.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <button type="submit" class="btn-login">Enviar instrucciones</button>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
